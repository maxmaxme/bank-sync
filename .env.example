# Copy to .env and fill in. Auto-loaded by `node src/index.ts` when running
# outside Docker. In Docker, pass these via env_file: / environment: instead.

# ─── Enable Banking (required) ────────────────────────────────────────
# Application id from https://enablebanking.com/cp/applications — it is also
# the file name of the .pem the control panel made you download.
EB_APP_ID=
# Must match one of the redirect URLs registered for the application, byte
# for byte. See README → "Redirect URL" for the options.
EB_REDIRECT_URL=
# Private key of the application. Defaults to $BANK_SYNC_DATA_DIR/enablebanking.pem.
EB_PRIVATE_KEY_PATH=

# Country whose banks the "connect" picker lists, and which one is preselected
# (case-insensitive substring of the bank name).
EB_COUNTRY=ES
EB_ASPSP=imagin

# ─── Sync ─────────────────────────────────────────────────────────────
# Hours between unattended syncs. Many banks allow ~4 unattended fetches a
# day per consent, so keep this >= 6.
SYNC_INTERVAL_HOURS=8

# ─── Telegram notifications (optional) ────────────────────────────────
# Sync failures/recoveries and "consent expires soon" reminders. Leave
# blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Runtime knobs ────────────────────────────────────────────────────
# Where the SQLite DB (and by default the key) lives. Override locally to e.g. ./data.
BANK_SYNC_DATA_DIR=
PORT=8080
TZ=Europe/Madrid
# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
