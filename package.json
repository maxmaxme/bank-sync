{
  "name": "bank-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted bank transaction sync over Enable Banking (PSD2) into SQLite, with a tiny web UI and JSON/CSV export",
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
